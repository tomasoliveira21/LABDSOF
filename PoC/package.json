{
  "name": "porto-bus-map",
  "private": true,
  "version": "1.0.0",
  "description": "Live map of STCP buses in Porto, fed by the Porto Digital FIWARE context broker, with route, zone and bus filters.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "zones": "node scripts/build-zones.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
