    },
    {
      "id": "00000000-0000-4000-8000-000000000007",
      "username": "vera@farol.test",
      "email": "vera@farol.test",
      "emailVerified": false,
      "firstName": "Vera",
      "lastName": "Por Verificar",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${FAROL_DEMO_PASSWORD}", "temporary": false }]
    }
  ]
}
