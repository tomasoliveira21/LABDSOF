      "username": "sofia@farol.test",
      "email": "sofia@farol.test",
      "emailVerified": true,
      "firstName": "Sofia",
      "lastName": "Organizadora",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${FAROL_DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000005",
      "username": "ines@farol.test",
      "email": "ines@farol.test",
      "emailVerified": true,
      "firstName": "Inês",
      "lastName": "Socorrista",
      "enabled": true,
