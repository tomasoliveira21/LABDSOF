# Copy to infra/.env once (cp infra/.env.example infra/.env), then replace every password with your own.
# The values here are harmless examples for local use and CI only: never reuse them, never commit infra/.env.
# Changing a database or Keycloak value after the first start needs a reset: docker compose -f infra/compose.yaml down -v

# Version and addresses (127.0.0.1 only: the demo runs on the laptop, local-delivery.md §1)
VERSION=dev
PUBLIC_HOST=localhost
GATEWAY_PORT=8080
WEB_PORT=3000
KEYCLOAK_PORT=8180
RABBITMQ_UI_PORT=15672
WIREMOCK_PORT=8090

# PostgreSQL: the superuser, then one owner per database (ADR-003)
POSTGRES_ADMIN_USER=farol_admin
POSTGRES_ADMIN_PASSWORD=example-only-postgres-admin
AUTH_USERS_DB_PASSWORD=example-only-auth-users-db
EVENTS_DB_PASSWORD=example-only-events-db
REPORTS_DB_PASSWORD=example-only-reports-db
TRANSPORTS_DB_PASSWORD=example-only-transports-db
BADGES_DB_PASSWORD=example-only-badges-db
KEYCLOAK_DB_PASSWORD=example-only-keycloak-db

# RabbitMQ (#212): the broker's admin (only rabbitmq-setup and the operator use it) and one user per service
RABBITMQ_ADMIN_USER=farol-admin
RABBITMQ_ADMIN_PASSWORD=example-only-rabbitmq-admin
RABBITMQ_AUTH_USERS_PASSWORD=example-only-auth-users-amqp
RABBITMQ_EVENTS_PASSWORD=example-only-events-amqp
RABBITMQ_REPORTS_PASSWORD=example-only-reports-amqp
RABBITMQ_TRANSPORTS_PASSWORD=example-only-transports-amqp
RABBITMQ_BADGES_PASSWORD=example-only-badges-amqp

# Keycloak (ADR-006): the temporary admin of the master realm and the farol realm's placeholders
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=example-only-keycloak-admin
FAROL_AUTH_USERS_CLIENT_SECRET=example-only-auth-users-client-secret
# The seeded account that becomes the first FarolAdmin (its e-mail is verified in the realm import, #179)
FAROL_BOOTSTRAP_FAROL_ADMIN_EMAIL=daniel@farol.test
# Password of every seeded test account (synthetic data only, M-13)
FAROL_DEMO_PASSWORD=example-only-demo-password
# Local AI (US-34, guide K1): empty = no AI, every request reads NotTriaged/Unavailable and the operator triages it.
# With the ai profile (docker compose --profile ai up), set http://ai:11434 and pull qwen3:4b first (local-delivery.md)
FAROL_AI_URL=

# Local observability (#148), only with `--profile observability`: Prometheus and Grafana on 127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=farol-grafana-admin
GRAFANA_ADMIN_PASSWORD=example-only-grafana-admin
